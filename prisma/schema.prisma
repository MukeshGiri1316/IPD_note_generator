// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  DOCTOR
  STAFF
}

enum AdmissionStatus {
  ACTIVE
  DISCHARGED
  TRANSFERRED
}

enum DocumentStatus {
  DRAFT
  GENERATED
  REVIEWED
  APPROVED
}

enum NoteType {
  DISCHARGE_SUMMARY
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents         Document[]        @relation("CreatedBy")
  approvedDocuments  Document[]        @relation("ApprovedBy")
  documentVersions   DocumentVersion[]
  auditLogs          AuditLog[]
}

model Patient {
  id            String    @id @default(cuid())
  patientNumber String    @unique
  name          String
  age           Int
  gender        String
  dateOfBirth   DateTime?
  phone         String?
  address       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  admissions Admission[]

  @@index([name])
  @@index([patientNumber])
}

model Admission {
  id                   String          @id @default(cuid())
  patientId            String
  ipdNumber            String          @unique
  admissionDate        DateTime
  dischargeDate        DateTime?
  primaryDiagnosis     String
  secondaryDiagnosis   String?
  clinicalHistory      String?
  symptoms             String?
  examinationFindings  String?
  investigationDetails Json?
  treatmentDetails     String?
  status               AdmissionStatus @default(ACTIVE)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  documents Document[]

  @@index([patientId])
  @@index([ipdNumber])
  @@index([status])
}

model Template {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  noteType     NoteType
  componentKey String
  version      Int      @default(1)
  placeholders Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents Document[]
}

model Document {
  id               String         @id @default(cuid())
  admissionId      String
  templateId       String
  createdById      String
  noteType         NoteType
  generatedContent Json
  finalContent     Json
  templateVersion  Int
  status           DocumentStatus @default(DRAFT)
  approvedById     String?
  approvedAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  admission  Admission         @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  template   Template          @relation(fields: [templateId], references: [id])
  createdBy  User              @relation("CreatedBy", fields: [createdById], references: [id])
  approvedBy User?             @relation("ApprovedBy", fields: [approvedById], references: [id])
  versions   DocumentVersion[]

  @@index([admissionId])
  @@index([noteType])
  @@index([status])
  @@index([createdById])
}

model DocumentVersion {
  id                String   @id @default(cuid())
  documentId        String
  versionNumber     Int
  content           Json
  changeDescription String?
  modifiedById      String
  createdAt         DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  modifiedBy User     @relation(fields: [modifiedById], references: [id])

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

